{
    admin off
    auto_https disable_redirects
    skip_install_trust
}
https://localhost:8443 {
    tls internal
    request_body {
        max_size 16384
    }
    @api path /api/v1/*
    handle @api {
        reverse_proxy api:8000 {
            header_up -X-Organization-ID
            header_up -X-Role
        }
    }
    handle {
        respond 404
    }
    header Cache-Control no-store
    header X-Content-Type-Options nosniff
    header Referrer-Policy no-referrer
}
