{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HYDROOVERITY M08 proposed local capture metadata — NOT PHYSICALLY VALIDATED",
  "type": "object",
  "additionalProperties": false,
  "required": ["capture_id", "device_configuration_id", "start_utc", "clock_id", "clock_source", "sample_rate_hz", "mclk_hz", "bclk_hz", "channels", "valid_bits", "slot_bits", "frames_written", "frames_expected", "dropout_frames", "overflow_count", "channel_order_verified", "calibration_id", "waveform_sha256", "qualification"],
  "properties": {
    "capture_id": {"type":"string","format":"uuid"},
    "device_configuration_id": {"type":"string","format":"uuid"},
    "start_utc": {"type":"string","format":"date-time"},
    "clock_id": {"type":"string","minLength":1,"maxLength":80},
    "clock_source": {"const":"ONE_PCM1808_EXTERNAL_OSCILLATOR"},
    "sample_rate_hz": {"const":48000},
    "mclk_hz": {"const":12288000},
    "bclk_hz": {"const":3072000},
    "channels": {"const":["LEFT","RIGHT"]},
    "valid_bits": {"const":24},
    "slot_bits": {"const":32},
    "frames_written": {"type":"integer","minimum":0},
    "frames_expected": {"type":"integer","minimum":1},
    "dropout_frames": {"type":"integer","minimum":0},
    "overflow_count": {"type":"integer","minimum":0},
    "channel_order_verified": {"type":"boolean"},
    "calibration_id": {"type":["string","null"],"maxLength":100},
    "waveform_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "qualification": {"enum":["UNCALIBRATED","INVALID","SUSPECT","QUALIFIED_FOR_REVIEW"]}
  },
  "$comment": "Schema defines storage shape, not qualification logic. Frame consistency, hash, physical-clock/channel checks and calibration must be enforced by future firmware/ingestion. No source/environment/truth field is accepted; trusted adapter assigns provenance."
}
